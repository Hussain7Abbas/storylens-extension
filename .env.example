# Extension runtime (WXT)
# Dev: local backend. Production builds use .env.production automatically.
WXT_API_URL="http://localhost:7001"
# Account pages (sign-in, registration, profile) and the session bridge origin.
WXT_WEBSITE_URL="http://localhost:3000"
# Google Analytics 4 (Measurement Protocol). Leave empty to disable analytics.
# Admin > Data streams > <stream> > Measurement ID / Measurement Protocol API secrets
WXT_GA_MEASUREMENT_ID=""
WXT_GA_API_SECRET=""
