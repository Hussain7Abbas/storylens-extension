{
	"name": "storylens-extension",
	"private": true,
	"version": "1.0.0",
	"license": "PolyForm-Noncommercial-1.0.0",
	"type": "module",
	"description": "Story Lens browser extension",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"postinstall": "wxt prepare",
		"orval": "orval --config ./orval.config.ts",
		"i18n:parse": "i18next --config i18next-parser.config.json"
	},
	"dependencies": {
		"@mantine/core": "^8.3.1",
		"@mantine/form": "^8.3.1",
		"@mantine/hooks": "^8.3.1",
		"@t3-oss/env-core": "^0.13.8",
		"@tabler/icons-react": "^3.35.0",
		"@tanstack/react-query": "^5.90.2",
		"@webext-core/messaging": "^2.3.0",
		"@wxt-dev/webextension-polyfill": "^1.0.0",
		"axios": "^1.16.1",
		"dexie": "^4.4.2",
		"i18next": "^25.5.2",
		"i18next-http-backend": "^3.0.2",
		"jotai": "^2.14.0",
		"mantine-datatable": "^8.2.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-hot-toast": "^2.6.0",
		"react-i18next": "^15.7.3",
		"react-router": "^7.9.1",
		"webextension-polyfill": "^0.12.0",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/react": "^19.1.12",
		"@types/react-dom": "^19.1.9",
		"@types/webextension-polyfill": "^0.12.3",
		"@wxt-dev/auto-icons": "^1.1.0",
		"@wxt-dev/module-react": "^1.1.3",
		"baseline-browser-mapping": "^2.10.32",
		"i18next-parser": "^9.3.0",
		"orval": "^7.11.2",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"typescript": "^5.9.2",
		"wxt": "^0.20.6"
	}
}
